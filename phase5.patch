+    <div class="dialog" role="dialog" aria-modal="true" aria-label="Open project" (click)="$event.stopPropagation()">
+      <div class="dialog-head">
+        <h2>Open project</h2>
+        <button type="button" (click)="closeDialog()" aria-label="Close">✕</button>
+      </div>
+
+      @if (listLoading()) {
+        <p class="note">Loading…</p>
+      } @else if (listError()) {
+        <p class="note error">{{ listError() }}</p>
+      } @else if (projects().length === 0) {
+        <p class="note">No saved projects yet. Press Save to create the first one.</p>
+      } @else {
+        <ul class="plist">
+          @for (p of projects(); track p.id) {
+            <li [class.current]="p.id === project.projectId()">
+              <button type="button" class="pick" (click)="openProject(p)">
+                <strong>{{ p.name }}</strong>
+                <small>Saved {{ stamp(p.updatedUtc) }}</small>
+              </button>
+              <button type="button" class="del" (click)="deleteProject(p)" title="Delete project" aria-label="Delete project">🗑</button>
+            </li>
+          }
+        </ul>
+      }
+    </div>
+  </div>
+}
